# Optional public endpoint overrides.
# No API keys are required for the current front-end integrations.
# Do not place private credentials in VITE_ variables; they are exposed to the browser.
# For a deployed static site, set VITE_EXOPLANET_TAP_URL to your own trusted
# server-side proxy endpoint. Local Vite development uses the built-in proxy.
VITE_NASA_APOD_URL=https://science.nasa.gov/wp-json/wp/v2/apod-basic
VITE_NASA_IMAGES_URL=https://images-api.nasa.gov
# VITE_EXOPLANET_TAP_URL=https://your-domain.example/api/exoplanet-archive/TAP/sync
VITE_SPACEFLIGHT_NEWS_URL=https://api.spaceflightnewsapi.net/v4
VITE_LAUNCH_LIBRARY_URL=https://ll.thespacedevs.com/2.3.0
